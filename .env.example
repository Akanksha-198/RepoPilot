# ---------- required ----------
POSTGRES_PASSWORD=change-me-strong-password
JWT_SECRET=paste-64-random-chars
ENCRYPTION_KEY=paste-64-hex-chars
INTERNAL_API_KEY=paste-32-random-chars

# your existing key(s) used by app/model.py and app/embeddings.py
MISTRAL_API_KEY=your-mistral-key

# ---------- site ----------
# Local test:   SITE_ADDRESS=:80        COOKIE_SECURE=false
# Real domain:  SITE_ADDRESS=repopilot.yourdomain.com   COOKIE_SECURE=true   (HTTPS is automatic)
SITE_ADDRESS=:80
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost

# ---------- optional ----------
DEFAULT_PERMISSION_LEVEL=3     # 1 Read, 2 Analyze, 3 Write, 4 Commit, 5 Push, 6 PR (first user is always admin, level 6)
MAX_REPAIR_ATTEMPTS=3
